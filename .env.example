# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-secure-random-string

# Google OAuth Provider
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Comma-separated email addresses manually approved for member access.
# An empty value denies all sign-ins and access to protected routes.
AUTHORIZED_EMAILS=approved1@example.com,approved2@example.com
